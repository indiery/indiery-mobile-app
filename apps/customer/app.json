{
  "expo": {
    "name": "Indiery",
    "slug": "indiery-customer",
    "scheme": "indierycustomer",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "expo-notifications"
    ],
    "extra": {
      "apiBaseUrl": "https://indiery-mobile-app-bp9h.onrender.com/api",
      "allowInsecureApiBaseUrl": false,
      "privacyPolicyUrl": "https://indiery-mobile-app-bp9h.onrender.com/privacy",
      "accountDeletionUrl": "https://indiery-mobile-app-bp9h.onrender.com/account-deletion",
      "googleMapsApiKey": "",
      "eas": {
        "projectId": "0e831c07-3e7f-4430-be30-59df033b2be1"
      }
    },
    "ios": {
      "bundleIdentifier": "com.indiery.customer",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Indiery uses your location to set accurate pickup and drop points for deliveries."
      }
    },
    "android": {
      "package": "com.indiery.customer",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS"
      ],
      "usesCleartextTraffic": false
    }
  }
}
