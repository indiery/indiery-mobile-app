NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/indiery
JWT_SECRET=dev-only-change-before-production
CORS_ORIGIN=http://localhost:8081,http://localhost:19006

# Firebase login verification
FIREBASE_PROJECT_ID=indiery-c8f7d
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Alternative: base64-encode the full Firebase service account JSON and set it here.
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Alternative for local machines/servers using Google ADC.
GOOGLE_APPLICATION_CREDENTIALS=

# Optional app integrations
GOOGLE_MAPS_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
EXPO_ACCESS_TOKEN=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=indiery
